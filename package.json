{
  "name": "museum-multiverse-the-lost-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:composition": "node scripts/check-print-composition.mjs",
    "build": "npm run check:composition && vite build && node scripts/export-static-routes.mjs",
    "build:luminary": "VITE_BASE_PATH=/apps/lost-pages/ VITE_PUBLIC_ORIGIN=https://luminarylabs.dev/apps/lost-pages npm run build",
    "deploy:luminary": "npm run build:luminary && node scripts/deploy-to-website.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "nexusengine": "git+https://github.com/LuminaryLabs-Dev/NexusEngine.git#55b7f33f6d008b2e3b120e370f09b96ed73105e9",
    "qrcode": "^1.5.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
